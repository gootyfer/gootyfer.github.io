---
import type { NoteSummary } from '../lib/notes';

interface Props {
  notes: readonly NoteSummary[];
}

const { notes } = Astro.props;
const visibleNotes = notes.slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<section id="notes" class="content-section" aria-labelledby="notes-heading">
  <div class="section-heading">
    <p class="section-index">02 / Learning log</p>
    <h2 id="notes-heading">Notes from the workbench</h2>
    <p>
      Product practice, adult learning, and what becomes visible when an idea is
      made real.
    </p>
  </div>
  <div>
    {visibleNotes.length > 0 ? (
      <div class="notes-list">
        {visibleNotes.map((note) => (
          <article class="note-card" lang={note.language}>
            <p class="eyebrow">
              {note.kind.replace('-', ' ')} · {note.readingMinutes} min
            </p>
            <h3>
              <a href={`/notes/${note.id}/`}>{note.title}</a>
            </h3>
            <p class="metadata">
              <time datetime={note.publishedAt.toISOString()}>
                {dateFormatter.format(note.publishedAt)}
              </time>
            </p>
            <p>{note.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">No notes published yet.</p>
    )}
  </div>
</section>
