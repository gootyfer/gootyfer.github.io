---
import { profile } from '../data/profile';
---

<header class="site-header">
  <a class="site-name" href="/">
    {profile.name}
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {[
        ['Notes', '/#notes'],
        ['Work', '/#work'],
        ['Talks', '/#talks'],
        ['Contact', '/#contact'],
      ].map(([label, href]) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
