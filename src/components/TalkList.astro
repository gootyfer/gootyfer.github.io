---
import { Image } from 'astro:assets';

import { talks } from '../data/talks';

const featuredTalk = talks.find((talk) => talk.featured);
const otherTalks = talks.filter((talk) => !talk.featured);
---

<section id="talks" class="content-section" aria-labelledby="talks-heading">
  <div class="section-heading">
    <p class="section-index">04 / Talks</p>
    <h2 id="talks-heading">Ideas shared in public</h2>
  </div>
  <div>
    {featuredTalk && (
      <article
        class="talk-feature"
        data-visual={featuredTalk.image ? 'photo' : 'typographic'}
      >
        {featuredTalk.image ? (
          <div class="talk-feature__visual">
            <Image
              src={featuredTalk.image}
              alt={featuredTalk.imageAlt ?? ''}
              widths={[480, 720, 960]}
              sizes="(min-width: 800px) 32vw, 100vw"
            />
          </div>
        ) : (
          <div class="talk-feature__type" aria-hidden="true">
            <span>LESS</span>
            <span>FEATURES</span>
            <span>MORE</span>
            <span>BUSINESS</span>
          </div>
        )}
        <div class="talk-feature__caption">
          <p class="eyebrow">Featured talk</p>
          <h3>{featuredTalk.title}</h3>
          <p class="metadata">
            {featuredTalk.event} · {featuredTalk.dateLabel ?? featuredTalk.year}
          </p>
          {featuredTalk.tagline && (
            <p class="talk-feature__tagline">{featuredTalk.tagline}</p>
          )}
          <div class="talk-feature__actions">
            {featuredTalk.slidesUrl && (
              <a href={featuredTalk.slidesUrl}>View slides</a>
            )}
            <a href={featuredTalk.url}>Conference page</a>
          </div>
        </div>
      </article>
    )}
    <div class="talk-list">
      {otherTalks.map((talk) => (
        <article class="talk-row">
          <h3>
            <a href={talk.url}>{talk.title}</a>
          </h3>
          <p class="metadata">
            {talk.event} · {talk.year}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
