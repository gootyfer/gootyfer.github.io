---
import { workItems } from '../data/work';
---

<section id="work" class="content-section" aria-labelledby="work-heading">
  <div class="section-heading">
    <p class="section-index">03 / Work</p>
    <h2 id="work-heading">Selected chapters</h2>
  </div>
  <div class="chapter-list">
    {workItems.map((item) => (
      <article class="chapter-row">
        <h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3>
        <p>{item.description}</p>
        <p class="metadata">{item.period}</p>
      </article>
    ))}
  </div>
</section>
