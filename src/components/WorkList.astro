---
import { workItems } from '../data/work';
---

<section id="work" class="content-section" aria-labelledby="work-heading">
  <div class="section-heading">
    <p class="eyebrow">Selected work</p>
    <h2 id="work-heading">Products, teams, and systems</h2>
  </div>
  <div class="editorial-list">
    {workItems.map((item) => (
      <article class="editorial-row">
        <div class="editorial-row__heading">
          <h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3>
          <p class="metadata">{item.period}</p>
        </div>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>
