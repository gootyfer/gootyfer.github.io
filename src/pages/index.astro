---
import Hero from '../components/Hero.astro';
import NotesList from '../components/NotesList.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ProjectList from '../components/ProjectList.astro';
import TalkList from '../components/TalkList.astro';
import WorkList from '../components/WorkList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { getPublishedNotes, toNoteSummary } from '../lib/notes';

const notes = (await getPublishedNotes()).map(toNoteSummary);
---

<BaseLayout
  title={`${profile.name} — Hands-on product leader`}
  description="Israel Gutiérrez is a hands-on product leader working across product, engineering, adult learning, and practical AI."
>
  <Hero />
  <section id="building" class="projects" aria-label="Selected projects">
    <ProjectFeature project={projects[0]} />
    <ProjectList projects={projects.slice(1)} />
  </section>

  <NotesList notes={notes} />
  <WorkList />
  <TalkList />
</BaseLayout>
