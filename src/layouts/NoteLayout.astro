---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  language?: string;
  notice?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  language = 'en',
  notice,
  backHref = '/#notes',
  backLabel = 'Back to notes',
} = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={`${title} — Israel Gutiérrez`}
  description={description}
  article
  {language}
>
  <article class="note">
    <header class="note__header">
      <a class="back-link" href={backHref}>
        ← {backLabel}
      </a>
      {notice && <p class="archive-notice">{notice}</p>}
      <h1>{title}</h1>
      <p class="note__description">{description}</p>
      <p class="metadata">
        Published{' '}
        <time datetime={publishedAt.toISOString()}>
          {dateFormatter.format(publishedAt)}
        </time>
        {updatedAt && (
          <>
            {' · Updated '}
            <time datetime={updatedAt.toISOString()}>
              {dateFormatter.format(updatedAt)}
            </time>
          </>
        )}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
